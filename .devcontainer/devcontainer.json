{
  "name": "arranger-cc",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",

  // OAuth token from `claude setup-token`, run locally once with a real
  // browser. Store the value as a Codespaces secret named
  // CLAUDE_CODE_OAUTH_TOKEN (repo or org level) — never paste the token
  // itself in this file.
  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}"
  },

  "postCreateCommand": "npm install && curl -fsSL https://claude.ai/install.sh | bash",

  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}