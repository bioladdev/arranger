{
	"name": "@overture-stack/arranger-components",
	"description": "React UI components for Overture Arranger servers",
	"version": "0.0.0-dev",
	"homepage": "https://github.com/overture-stack/arranger#readme",
	"bugs": {
		"url": "https://github.com/overture-stack/arranger/issues"
	},
	"repository": {
		"directory": "modules/components",
		"type": "git",
		"url": "git+https://github.com/overture-stack/arranger.git"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"imports": {
		"#public": "./public",
		"#*": "./src/*"
	},
	"scripts": {
		"playground": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"build:types": "tsc --emitDeclarationOnly --project tsconfig.release.json",
		"clear:dist": "rm -rf dist",
		"test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --config=jest.config.ts",
		"test:watch": "npm test -- --watch",
		"watch": "npm run clear:dist && npm run build -- --watch"
	},
	"dependencies": {
		"@tanstack/react-table": "^8.7.9",
		"axios": "^1.16.0",
		"classnames": "^2.3.2",
		"color": "^4.2.3",
		"convert-units": "^2.3.4",
		"date-fns": "^2.29.3",
		"downshift": "^1.23.2",
		"filesize": "^10.0.6",
		"jsonpath-plus": "^10.3.0",
		"lodash-es": "^4.17.21",
		"pluralize": "^8.0.0",
		"react-datepicker": "^4.10.0",
		"react-icons": "^5.4.0",
		"react-input-range": "^1.3.0",
		"react-router-dom": "^4.2.2",
		"react-table-old": "npm:react-table@^6.11.5",
		"react-tippy": "^1.4.0",
		"url-join": "^4.0.1",
		"uuid": "^9.0.0"
	},
	"devDependencies": {
		"@overture-stack/arranger-types": "^0.0.0-dev",
		"@rolldown/plugin-babel": "^0.2.3",
		"@storybook/addon-actions": "^3.3.8",
		"@storybook/addon-options": "^3.3.11",
		"@storybook/react": "^3.3.3",
		"@types/color": "^3.0.3",
		"@types/jest": "^29.5.0",
		"@types/lodash-es": "^4.17.12",
		"@types/pluralize": "^0.0.29",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/url-join": "^4.0.1",
		"@vitejs/plugin-react": "^6.0.4",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.4",
		"eslint-plugin-react-hooks": "^5.2.0",
		"jest": "^29.7.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"ts-jest": "^29.0.5",
		"ts-node": "^10.9.2",
		"type-fest": "^3.6.1",
		"typescript": "^5.9.3",
		"typescript-transform-paths": "^3.5.3",
		"vite": "^8.1.5"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
